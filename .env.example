# ---------------------------------------------------------------------------
# Envoyix environment variables
#
# Copy to .env.local for development:  cp .env.example .env.local
# Every variable here is OPTIONAL — the app runs with none of them set.
# ---------------------------------------------------------------------------

# Public base URL of this deployment.
# Used for canonical URLs, Open Graph tags, JSON-LD @id values and sitemap.xml.
# Set this per environment or previews will emit production canonicals.
# Default: https://envoyix.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional AI review step
#
# When enabled, the extracted page text is sent to the Anthropic API and 3–5
# rewrite suggestions are returned alongside the deterministic report. The app
# works fully without this; if the call fails the report is returned unchanged.
#
# Note: enabling this sends the analysed page's text to Anthropic. Say so in
# your privacy policy if you run a public instance.
# ---------------------------------------------------------------------------

# Master switch. Must be exactly "true" to enable. Default: disabled.
ENABLE_LLM_REVIEW="false"

# Anthropic API key. Required only when ENABLE_LLM_REVIEW=true.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Model to use for the review step. Default: claude-opus-5
ANTHROPIC_MODEL="claude-opus-5"
